# Never ignore .meta files — Unity needs them.
!/[Aa]ssets/**/*.meta

# Autogenerated project files
*.csproj
*.sln
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Local Tarinoi configuration. Points at a specific Tarinoi project, so it is
# per-developer rather than shared — and this repository is public, so our dev
# instance's group and project ids do not belong in it.
/Assets/Resources/TarinoiSettings.asset
/Assets/Resources/TarinoiSettings.asset.meta

# OS / IDE
.DS_Store
.idea/
.vscode/
.vs/
