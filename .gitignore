[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore .meta files — Unity needs them.
!/[Aa]ssets/**/*.meta

# Autogenerated project files
*.csproj
*.sln
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Local Tarinoi configuration. Points at a specific Tarinoi project, so it is
# per-developer rather than shared — and this repository is public, so our dev
# instance's group and project ids do not belong in it.
/Assets/Resources/TarinoiSettings.asset
/Assets/Resources/TarinoiSettings.asset.meta

# Bindings generated from whichever Tarinoi project this checkout is pointed at.
# Regenerate with Tools > Tarinoi > Regenerate Bindings after syncing.
/Assets/Tarinoi/Generated/

# Exported content snapshot — specific to whichever Tarinoi project this
# checkout syncs from. Re-export with Tools > Tarinoi > Snapshot for Export.
/Assets/StreamingAssets/tarinoi/

# OS / IDE
.DS_Store
.idea/
.vscode/
.vs/
